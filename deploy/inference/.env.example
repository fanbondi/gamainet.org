# AI-GAMNET inference server — environment configuration
# Copy to .env and edit before: docker compose --profile ascend-910b up -d

# ── Profile ───────────────────────────────────────────────────────────────────
# Use with: docker compose --profile ascend-910b up -d
#        or docker compose --profile ascend-310p up -d
ASCEND_PROFILE=910b

# ── Model ─────────────────────────────────────────────────────────────────────
# Hugging Face model ID (downloaded on first start; can take 5–15 min)
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# Set true if Hugging Face is slow from your region (uses ModelScope mirror)
VLLM_USE_MODELSCOPE=false

# ── Ports (host) ──────────────────────────────────────────────────────────────
VLLM_PORT=8000
OPEN_WEBUI_PORT=3000

# ── Open WebUI ────────────────────────────────────────────────────────────────
WEBUI_NAME=AI-GAMNET Inference
OPENAI_API_KEY=local
# Set false after creating admin account in production
ENABLE_SIGNUP=true

# ── Atlas 910B / 800I A2 ─────────────────────────────────────────────────────
VLLM_ASCEND_IMAGE_910B=quay.io/ascend/vllm-ascend:v0.10.0rc1
ASCEND_DEVICE_910B=/dev/davinci0
VLLM_MAX_MODEL_LEN_910B=8192
VLLM_TENSOR_PARALLEL_910B=1
VLLM_DTYPE_910B=auto

# ── Atlas 310P (300I Duo) ─────────────────────────────────────────────────────
# Use image tag verified for your CANN version: quay.io/ascend/vllm-ascend
VLLM_ASCEND_IMAGE_310P=quay.io/ascend/vllm-ascend:v0.10.0rc1-310p
ASCEND_DEVICE_310P_0=/dev/davinci0
ASCEND_DEVICE_310P_1=/dev/davinci1
VLLM_MAX_MODEL_LEN_310P=4096
VLLM_TENSOR_PARALLEL_310P=2

# ── Shared ────────────────────────────────────────────────────────────────────
VLLM_SHM_SIZE=1g
PYTORCH_NPU_ALLOC_CONF=max_split_size_mb:256
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:main
